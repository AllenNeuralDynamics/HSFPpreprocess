{
	"version": 1,
	"base_image": "codeocean/jupyterlab:3.6.1-miniconda4.12.0-python3.9-ubuntu20.04",
	"options": {
		"registry_host_arg": true,
		"git_ask_pass": true,
		"mount_secrets": true
	},
	"installers": {
		"pip": {
			"packages": [
				{
					"name": "h5py",
					"version": "3.14.0"
				},
				{
					"name": "matplotlib",
					"version": "3.9.4"
				},
				{
					"name": "natsort",
					"version": "8.4.0"
				},
				{
					"name": "numpy",
					"version": "1.25.2"
				},
				{
					"name": "opencv-python-headless",
					"version": "4.7.0.72"
				},
				{
					"name": "pandas",
					"version": "2.3.3"
				},
				{
					"name": "pillow",
					"version": "11.3.0"
				},
				{
					"name": "scikit-image",
					"version": "0.24.0"
				},
				{
					"name": "scikit-learn",
					"version": "1.6.1"
				},
				{
					"name": "scipy",
					"version": "1.13.1"
				},
				{
					"name": "seaborn",
					"version": "0.13.2"
				},
				{
					"name": "tables",
					"version": "3.8.0"
				},
				{
					"name": "toml",
					"version": "0.10.2"
				}
			],
			"options": {},
			"pre_install_options": {}
		},
		"vscode": {
			"packages": [
				{
					"name": "ms-python.python",
					"version": "2025.14.0"
				},
				{
					"name": "ms-toolsai.jupyter",
					"version": "2025.4.1"
				},
				{
					"name": "reditorsupport.r",
					"version": "2.8.6"
				},
				{
					"name": "saoudrizwan.claude-dev",
					"version": "3.35.1"
				}
			],
			"version": "4.100.3"
		}
	}
}